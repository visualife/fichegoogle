{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.fichegoogle.com" }],
      "destination": "https://fichegoogle.com/$1",
      "permanent": true
    },
    {
      "source": "/:p(privacy|terms|contact|audit|account|login|qr-code-avis-google)",
      "destination": "https://googlow.fr/:p",
      "permanent": true
    }
  ]
}
